# ===============================================================
# LISON — Environment Variables Example Configuration
# ===============================================================

# Server Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Security & Sessions
JWT_SECRET=lison_production_secure_jwt_secret_key_change_me_in_render_2026

# Dedicated Platform Administrator Account
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=1234

# Artificial Intelligence (Gemini AI Teacher)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Email Delivery (Resend API for Password Reset & Verification)
# Get your API key at: https://resend.com/
RESEND_API_KEY=
EMAIL_FROM=LISON <noreply@lison.uz>

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=

# Database Path (Defaults to backend/ziyo_academy.db)
DATABASE_PATH=backend/ziyo_academy.db
